# Exa API Configuration
EXA_API_KEY=your_exa_api_key_here

# Claude Code Configuration (for Railway deployment)
# Get token with: claude auth login --print-token
CLAUDE_CODE_OAUTH_TOKEN=your_claude_oauth_token_here
CLAUDE_API_URL=http://localhost:3001
CLAUDE_API_PORT=3001

# Query Refinement (uses Claude for query optimization)
QUERY_REFINEMENT_ENABLED=true

# Application Configuration
PUBLIC_APP_NAME=Healthcare Jobs - People Search
